{
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "value": "YOUR_SHEET_ID_HERE",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "options": {}
      },
      "id": "1",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "model": "llama3",
        "options": {}
      },
      "id": "2",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [620, 500],
      "credentials": {
        "ollamaApi": {
          "id": "LOCAL_OLLAMA_CRED",
          "name": "Local Ollama"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a 1-sentence WhatsApp notification for {{ $json.To }} about the task: {{ $json.Task }}. Description: {{ $json.Description }}. Keep it friendly and concise.",
        "options": {}
      },
      "id": "3",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [620, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "from": "whatsapp:+14155238886",
        "to": "='whatsapp:' + $json.ToNumber",
        "message": "={{ $node[\"AI Agent\"].json[\"output\"] }}"
      },
      "id": "4",
      "name": "Twilio WhatsApp",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [880, 300],
      "credentials": {
        "twilioApi": {
          "id": "TWILIO_CRED_ID",
          "name": "Twilio Account"
        }
      }
    }
  ],
  "connections": {
    "Google Sheets Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Twilio WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
